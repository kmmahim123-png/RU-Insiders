# ==============================================================================
# RU INSIDERS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your production values.
# NEVER commit .env.local or real secrets to Git.
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RU Insiders"
NODE_ENV="development"

# Authentication & Security
# Generate using: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"
ADMIN_SESSION_COOKIE="ru_admin_token"
ADMIN_DEFAULT_PIN="1953" # Rajshahi University founding year default admin PIN

# Steadfast Courier Service API (Bangladesh)
# Obtain from your Steadfast Merchant Dashboard (https://steadfast.com.bd)
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# Document & Print Station
MAX_PDF_UPLOAD_SIZE_MB=50
STORAGE_DRIVER="local" # 'local' for self-hosted or 's3'/'supabase' for cloud blob

# Database & Scale (Ready for PostgreSQL / Neon / Supabase or Serverless)
DATABASE_URL="file:./dev.db"
